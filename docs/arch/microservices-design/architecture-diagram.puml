@startuml C4_Code_Ledger_Service
title Code Diagram (L4) - Ledger Service Hexagonal Architecture

skinparam classAttributeIconSize 0

package "Adapters::Inbound::HTTP" {
    class RecordHandler {
        -recordUC: RecordUseCase
        +PostExpense(ctx: context.Context, input: PostExpenseInput): (PostExpenseOutput, error)
        +PostIncome(ctx: context.Context, input: PostIncomeInput): (PostIncomeOutput, error)
        +RegisterRoutes(api: huma.API): void
    }
}

package "Core::Ports::Inbound" {
    interface RecordUseCase {
        +CreateExpenseFromReceipt(ctx: context.Context, cmd: CreateExpenseCmd): (*Record, error)
        +CreateManualExpense(ctx: context.Context, cmd: CreateManualExpenseCmd): (*Record, error)
        +GetRecords(ctx: context.Context, filter: RecordFilter): ([]Record, error)
    }
}

package "Core::Domain::Services" {
    class RecordService {
        -repo: RecordRepository
        -receiptClient: ReceiptClient
        -outbox: OutboxPublisher
        +CreateExpenseFromReceipt(ctx: context.Context, cmd: CreateExpenseCmd): (*Record, error)
        +CreateManualExpense(ctx: context.Context, cmd: CreateManualExpenseCmd): (*Record, error)
        +GetRecords(ctx: context.Context, filter: RecordFilter): ([]Record, error)
    }
}

package "Core::Domain::Entities" {
    class Record {
        +ID: uuid.UUID
        +UserID: uuid.UUID
        +Amount: decimal.Decimal
        +Type: RecordType
        +CategoryID: uuid.UUID
        +ReceiptID: *uuid.UUID
        +BankProvider: *string
        +OccurredAt: time.Time
        +Validate(): error
    }
}

package "Core::Ports::Outbound" {
    interface RecordRepository {
        +Save(ctx: context.Context, tx: DBTx, record: *Record): error
        +FindByID(ctx: context.Context, id: uuid.UUID): (*Record, error)
        +FindByFilter(ctx: context.Context, filter: RecordFilter): ([]Record, error)
    }

    interface ReceiptClient {
        +GetReceipt(ctx: context.Context, id: uuid.UUID): (*ReceiptDetails, error)
    }

    interface OutboxPublisher {
        +Publish(ctx: context.Context, tx: DBTx, event: OutboxEvent): error
    }
}

package "Adapters::Outbound::Postgres" {
    class PostgresRecordRepo {
        -db: *bun.DB
        +Save(ctx: context.Context, tx: DBTx, record: *Record): error
        +FindByID(ctx: context.Context, id: uuid.UUID): (*Record, error)
        +FindByFilter(ctx: context.Context, filter: RecordFilter): ([]Record, error)
    }

    class PostgresOutboxPublisher {
        -db: *bun.DB
        +Publish(ctx: context.Context, tx: DBTx, event: OutboxEvent): error
    }
}

package "Adapters::Outbound::GRPC" {
    class GRPCReceiptClient {
        -client: pb.ReceiptServiceClient
        +GetReceipt(ctx: context.Context, id: uuid.UUID): (*ReceiptDetails, error)
    }
}

RecordHandler ..> RecordUseCase : calls
RecordService ..|> RecordUseCase : implements
RecordService --> RecordRepository : uses
RecordService --> ReceiptClient : uses
RecordService --> OutboxPublisher : uses
RecordService ..> Record : instantiates

PostgresRecordRepo ..|> RecordRepository : implements
GRPCReceiptClient ..|> ReceiptClient : implements
PostgresOutboxPublisher ..|> OutboxPublisher : implements

@enduml

@startuml Sequence_UC01
title Sequence Diagram - UC-01: Ingest Expense from Bank Receipt

actor Customer as U
participant "Mobile App" as App
participant "Traefik" as TR
participant "Receipt SVC" as RC
participant "Object Storage" as S3
queue "Redpanda" as K
participant "Reader SVC" as RD
participant "Suggestion SVC" as SG
participant "Ledger SVC" as LG
participant "Dashboard SVC" as DS

U -> App: Bank app saves receipt to gallery
App -> App: Media-library watcher detects new image
App -> TR: POST /receipts (multipart) [REST]
TR -> RC: Forward (JWT validated via ForwardAuth)
RC -> RC: sha256(image), reject if duplicate
RC -> S3: PutObject (SSE-encrypted)
RC -> RC: TX: INSERT receipt(status=uploaded) + outbox
RC -->> App: 202 Accepted {receipt_id}
RC -> K: Publish receipt.uploaded

K -> RD: Consume receipt.uploaded
RD -> S3: GetObject
RD -> RD: OCR / VLM extract fields
alt extraction succeeded
    RD -> K: Publish receipt.extracted
else failed
    RD -> K: Publish receipt.extraction_failed
end

par Receipt persists facts
    K -> RC: Consume receipt.extracted
    RC -> RC: UPDATE status=extracted
    RC -> App: Push "New expense detected"
else Suggestion classifies
    K -> SG: Consume receipt.extracted
    SG -> LG: GetCategories(user_id) [gRPC]
    LG -->> SG: Return categories
    SG -> SG: Match merchant to category
    SG -> K: Publish receipt.suggested
end

K -> RC: Consume receipt.suggested
RC -> RC: UPDATE suggested_category_id, status=suggested
opt User has not confirmed yet
    RC -> App: Push "Suggested: Food - confirm?"
end

U -> App: Tap category (confirm or change)
App -> TR: POST /records {receipt_id, category_id} [REST]
TR -> LG: Forward
LG -> RC: GetReceipt(receipt_id) [gRPC]
RC -->> LG: Return receipt metadata
LG -> LG: TX: INSERT record (UNIQUE receipt_id) + outbox
LG -->> App: 201 Created
LG -> K: Publish ledger.expense.created

par Update receipt status
    K -> RC: Consume ledger.expense.created
    RC -> RC: UPDATE status=confirmed
else Project read model
    K -> DS: Consume ledger.expense.created
    DS -> DS: Project into ClickHouse read model
end
@enduml

@startuml Sequence_UC03
title Sequence Diagram - UC-03: Review Dashboard

actor Customer as U
participant "Mobile App" as App
participant "Traefik" as TR
participant "Dashboard SVC" as DS
database "ClickHouse" as CH
participant "Ledger SVC" as LG

U -> App: Open dashboard (type, range, bank filter)
App -> TR: GET /dashboard/donut?... [REST]
TR -> DS: Forward
alt Read model available (normal path)
    DS -> CH: SELECT from AggregatingMergeTree rollup
    CH -->> DS: Return aggregated buckets
else ClickHouse unavailable / Sprint 1 fallback
    note over DS, LG
      Graceful degradation path
    end note
    DS -> LG: GetRecords(filter) [gRPC]
    LG -->> DS: Return raw records
    DS -> DS: Aggregate in memory
end
DS -->> App: Return chart JSON [REST]
App -->> U: Render donut / bar charts
@enduml
