System(bogbank, "BogBank System", "Automated receipt ingestion, manual ledger, and spending dashboard.")

System_Ext(google_auth, "Google OAuth 2.0", "Identity provider for authentication via PKCE.")
System_Ext(vlm_api, "Receipt OCR / VLM API", "Extracts transaction metadata from receipts (Gemini Flash / Typhoon OCR).")
