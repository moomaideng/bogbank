Container(dash_svc, "Dashboard SVC", "Go", "Synchronous gRPC client.")
Container(redpanda, "Redpanda", "Kafka API", "Message broker for async events.")
ContainerDb(ledger_db, "PostgreSQL", "ledger schema", "Stores records, categories, and outbox.")
