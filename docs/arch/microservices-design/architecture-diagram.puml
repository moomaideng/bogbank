@startuml C4_Container_BogBank
!include <C4/C4_Container>

title Container Diagram for BogBank System (L2)

Person(customer, "Customer", "Uses the native mobile app")

System_Ext(google_auth, "Google OAuth 2.0", "Identity provider")
System_Ext(vlm_api, "Receipt OCR / VLM API", "Gemini Flash / Typhoon OCR")
System_Ext(expo_push, "Expo Push Service", "Push notification delivery")

System_Boundary(bogbank_system, "BogBank System") {
    Container(mobile_app, "Mobile App", "TypeScript, React Native", "Client interface for gallery watch, manual entry, and dashboards.")
    Container(traefik, "Traefik Ingress Gateway", "Traefik v3", "TLS termination, routing, rate limiting, and ForwardAuth JWT verification.")

    Container(auth_svc, "Auth SVC", "Go, chi + Huma", "Google OAuth PKCE validation, BogBank JWT issuance & token introspection.")
    Container(receipt_svc, "Receipt SVC", "Go, chi + Huma", "Bank hooks, receipt uploads, SHA-256 dedupe, lifecycle state machine, push triggers.")
    Container(reader_svc, "Receipt Reader SVC", "Go", "Stateless worker consuming uploaded receipts, invoking VLM OCR extraction.")
    Container(suggest_svc, "Suggestion SVC", "Go", "Rule-based merchant-to-category matcher.")
    Container(ledger_svc, "Ledger SVC", "Go, chi + Huma", "Financial system of record: income, expense, and category management.")
    Container(dash_svc, "Dashboard SVC", "Go, chi + Huma", "CQRS read model aggregator for donut/bar charts and projections.")

    ContainerDb(auth_db, "Auth Database", "PostgreSQL", "Stores users and refresh tokens (auth schema).")
    ContainerDb(receipt_db, "Receipt Database", "PostgreSQL", "Stores bank hooks, receipts, audit events, and outbox table.")
    ContainerDb(ledger_db, "Ledger Database", "PostgreSQL", "Stores financial records, categories, and transactional outbox.")
    ContainerDb(ch_db, "Read Model Store", "ClickHouse", "Stores records_mv and AggregatingMergeTree rollups.")
    ContainerDb(redis_db, "Cache & State Store", "Redis", "Consumer idempotency keys, category cache, and sessions.")
    ContainerDb(blob_store, "Object Storage", "S3 / RustFS", "Stores SSE-encrypted receipt images.")

    Container(redpanda, "Message Broker", "Redpanda (Kafka API)", "Asynchronous event choreography and transactional outbox relay.")
}

Rel(customer, mobile_app, "Interacts with", "UI")
Rel(mobile_app, google_auth, "OAuth 2.0 PKCE sign-in", "HTTPS")
Rel(mobile_app, traefik, "API requests", "REST")

Rel(traefik, auth_svc, "ForwardAuth token validation", "REST")
Rel(traefik, auth_svc, "Routes /auth/*", "REST")
Rel(traefik, receipt_svc, "Routes /receipts/*", "REST")
Rel(traefik, ledger_svc, "Routes /records/*, /categories/*", "REST")
Rel(traefik, dash_svc, "Routes /dashboard/*", "REST")

Rel(auth_svc, google_auth, "Verifies Google ID tokens", "HTTPS")
Rel(auth_svc, auth_db, "Reads/writes users & tokens", "SQL")
Rel(auth_svc, redis_db, "Caches session tokens", "Redis")

Rel(receipt_svc, receipt_db, "Persists receipts & outbox", "SQL")
Rel(receipt_svc, blob_store, "Puts receipt images", "S3 API")
Rel(receipt_svc, expo_push, "Triggers push notifications", "HTTPS")
Rel(receipt_svc, redpanda, "Publishes receipt.uploaded via outbox", "Kafka")

Rel(redpanda, reader_svc, "Consumes receipt.uploaded", "Kafka")
Rel(reader_svc, blob_store, "Gets receipt image", "S3 API")
Rel(reader_svc, vlm_api, "Extracts fields via VLM", "HTTPS")
Rel(reader_svc, redpanda, "Publishes receipt.extracted", "Kafka")

Rel(redpanda, suggest_svc, "Consumes receipt.extracted", "Kafka")
Rel(suggest_svc, ledger_svc, "Queries GetCategories", "gRPC")
Rel(suggest_svc, redis_db, "Caches categories & dedupes", "Redis")
Rel(suggest_svc, redpanda, "Publishes receipt.suggested", "Kafka")

Rel(redpanda, receipt_svc, "Consumes receipt.extracted & receipt.suggested", "Kafka")

Rel(ledger_svc, receipt_svc, "Queries GetReceipt (verification)", "gRPC")
Rel(ledger_svc, ledger_db, "Persists records & outbox", "SQL")
Rel(ledger_svc, redpanda, "Publishes ledger.* events via outbox", "Kafka")

Rel(redpanda, dash_svc, "Consumes ledger.* events", "Kafka")
Rel(dash_svc, ch_db, "Projects & queries read model", "SQL")
Rel(dash_svc, ledger_svc, "Fallback: GetRecords", "gRPC")
