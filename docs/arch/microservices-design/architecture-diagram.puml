Rel(bogbank, vlm_api, "Extracts receipt fields", "HTTPS")
Rel(bogbank, expo_push, "Sends push notifications", "HTTPS")
Rel(expo_push, customer, "Delivers push notification to phone", "Push Notification")
Rel(bogbank, object_storage, "Stores and retrieves receipt images", "S3 API")
